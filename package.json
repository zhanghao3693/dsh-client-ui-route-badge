{
  "name": "dsh-client-ui-route-badge",
  "version": "0.1.0",
  "description": "Shows which backend model actually served each request when using the auto route.",
  "type": "module",
  "author": "zhanghao3693",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhanghao3693/dsh-client-ui-route-badge.git"
  },
  "homepage": "https://github.com/zhanghao3693/dsh-client-ui-route-badge",
  "bugs": {
    "url": "https://github.com/zhanghao3693/dsh-client-ui-route-badge/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "plugin",
    "client-ui",
    "route-badge",
    "model-routing"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "README.md"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "engines": {
      "dsh": ">=0.1.0-rc.5"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.0-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "license": "MIT"
}
